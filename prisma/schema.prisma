generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:postgres@localhost:5433/recircular-database?schema=public"

}


model Item {
  id     String    @id @default(uuid())
  name String
  description String
  category Category
  statusConservation StatusConservation
  availability Boolean
  size String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Item_table")
}

enum StatusConservation {
  Novo
  Usado

}

enum Category {
  Eletronico
  Vestuario
  Papelaria
}